# Copy to .env.local. Every variable the app reads is listed here.
# With INSTAGRAM_SOURCE=mock and AI_PROVIDER=mock, only DATABASE_URL is needed locally.

# --- Supabase (public URL + anon key are safe in the browser; RLS protects data) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server + background jobs only. Never used in a user-facing request path.
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection for migrations and scripts, e.g.
# postgres://postgres:password@localhost:5432/creator_baseline
DATABASE_URL=

# --- AI (server only) ---
AI_PROVIDER=mock                # anthropic | gemini | mock
ANTHROPIC_API_KEY=
# AI_PROVIDER=gemini: Google AI Studio key (free tier). The fallback is used when the model is busy.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest

# --- Instagram ---
INSTAGRAM_SOURCE=mock           # graph | mock
INSTAGRAM_LOGIN_TYPE=unified    # unified (new Meta apps) | instagram (older apps) | facebook (via a Page)
# Unified Login: the configuration id from Use cases > Instagram API > API setup with Unified login
INSTAGRAM_LOGIN_CONFIG_ID=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Must match the app's Valid OAuth Redirect URI, e.g. http://localhost:3000/api/creators/callback
INSTAGRAM_REDIRECT_URI=
# 32 random bytes, base64. Encrypts Instagram tokens and signs the OAuth state cookie. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Required in production and when INSTAGRAM_SOURCE=graph. In local mock mode an unset key is derived from SESSION_SECRET.
TOKEN_ENCRYPTION_KEY=

# --- Rate limiting / cache (optional in dev, required in production) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Jobs ---
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

APP_BASE_URL=http://localhost:3000

# --- Local development only ---
# Signs the dev session cookie when Supabase Auth is not configured (NEXT_PUBLIC_SUPABASE_URL empty).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=
# Separate database for `pnpm test:integration` (it is reset on every run).
TEST_DATABASE_URL=
