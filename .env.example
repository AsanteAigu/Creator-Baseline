# Copy to .env.local. Every variable the app reads is listed here.
# With INSTAGRAM_SOURCE=mock and AI_PROVIDER=mock, only DATABASE_URL is needed locally.

# --- Supabase (public URL + anon key are safe in the browser; RLS protects data) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server + background jobs only. Never used in a user-facing request path.
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection for migrations and scripts, e.g.
# postgres://postgres:password@localhost:5432/creator_baseline
DATABASE_URL=

# --- AI (server only) ---
AI_PROVIDER=mock                # anthropic | mock
ANTHROPIC_API_KEY=

# --- Instagram ---
INSTAGRAM_SOURCE=mock           # graph | mock
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=
# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# --- Rate limiting / cache (optional in dev, required in production) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Jobs ---
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

APP_BASE_URL=http://localhost:3000
